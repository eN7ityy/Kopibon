<?xpacket begin="{{bom}}" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">{{title}}</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">{{description}}</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:creator>
        <rdf:Seq>
{{#each creators}}
          <rdf:li>{{.}}</rdf:li>
{{/each}}
        </rdf:Seq>
      </dc:creator>
      <dc:subject>
        <rdf:Bag>
{{#each tags}}
          <rdf:li>{{.}}</rdf:li>
{{/each}}
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>{{#publisher}}<rdf:li>{{publisher}}</rdf:li>{{/publisher}}</rdf:Bag>
      </dc:publisher>
{{#languageIso}}
      <dc:language>
        <rdf:Bag>
          <rdf:li>{{languageIso}}</rdf:li>
        </rdf:Bag>
      </dc:language>
{{/languageIso}}
      <dc:date>
        <rdf:Seq>
          <rdf:li>{{date}}</rdf:li>
        </rdf:Seq>
      </dc:date>
    <pdfx:isbn xmlns:pdfx="http://ns.adobe.com/pdfx/1.3/">{{galleryId}}</pdfx:isbn><prism2:isbn xmlns:prism2="http://prismstandard.org/namespaces/basic/2.0/">{{galleryId}}</prism2:isbn><pdf:Producer xmlns:pdf="http://ns.adobe.com/pdf/1.3/">{{producer}}</pdf:Producer></rdf:Description>
    <rdf:Description xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
      <xmp:MetadataDate>{{metadataDate}}</xmp:MetadataDate>
    </rdf:Description>
{{#seriesName}}
    <rdf:Description xmlns:calibreSI="http://calibre-ebook.com/xmp-namespace-series-index" xmlns:calibre="http://calibre-ebook.com/xmp-namespace" rdf:about="">
      <calibre:series rdf:parseType="Resource">
        <rdf:value>{{seriesName}}</rdf:value>
        <calibreSI:series_index>{{seriesIndex?}}</calibreSI:series_index>
      </calibre:series>
      <calibre:timestamp>{{date}}</calibre:timestamp>
      <calibre:title_sort>{{title}}</calibre:title_sort>
      <calibre:author_sort>{{authorSort}}</calibre:author_sort>
    </rdf:Description>
{{/seriesName}}
  </rdf:RDF>
</x:xmpmeta>
<?xpacket end="w"?>
